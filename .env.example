# Copy to .env on the Oracle VM. Never commit the real .env file.
MYSQL_DATABASE=healthcare_platform
MYSQL_USER=health_user
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password
JWT_SECRET=replace-with-a-long-random-application-secret
APP_PORT=8080
